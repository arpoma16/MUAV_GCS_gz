<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_gimbal_collision">

    <!-- Inherit the full x500_gimbal model (frame + motors + gimbal + plugins).
         The gimbal (cgo3_* links, camera_link) already comes from here. -->
    <include merge="true">
      <uri>model://x500_gimbal</uri>
    </include>

    <!-- ================================================================
         FORWARD distance sensor (+X, in front of the frame plate)
    ================================================================ -->
    <link name="distance_sensor_forward_link">
      <pose>0.19 0 0.24 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_forward" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_forward_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_forward_link</child>
    </joint>

    <!-- ================================================================
         BACKWARD distance sensor (-X, behind the frame plate)
    ================================================================ -->
    <link name="distance_sensor_backward_link">
      <pose>-0.19 0 0.24 0 0 3.14159</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_backward" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_backward_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_backward_link</child>
    </joint>

    <!-- ================================================================
         LEFT distance sensor (+Y, left of the frame plate)
    ================================================================ -->
    <link name="distance_sensor_left_link">
      <pose>0 0.19 0.24 0 0 1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_left" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_left_link</child>
    </joint>

    <!-- ================================================================
         RIGHT distance sensor (-Y, right of the frame plate)
    ================================================================ -->
    <link name="distance_sensor_right_link">
      <pose>0 -0.19 0.24 0 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_right" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_right_link</child>
    </joint>

    <!-- ================================================================
         UP distance sensor (+Z, above the top plate)
    ================================================================ -->
    <link name="distance_sensor_up_link">
      <pose>0 0 0.32 0 -1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_up" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_up_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_up_link</child>
    </joint>

    <!-- ================================================================
         DOWN distance sensor (-Z, below the plate, offset backwards to dodge the gimbal (also usable as altimeter))
    ================================================================ -->
    <link name="distance_sensor_down_link">
      <pose>-0.12 0 0.2 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="distance_down" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <!-- 5x3 rays over +-15 deg: emulates the cone of a ToF/ultrasonic sensor.
                 Keep the half-angle below ~20 deg or the rays hit the own propellers. -->
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </horizontal>
            <vertical>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221</min_angle>
              <max_angle>0.1221</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="distance_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>distance_sensor_down_link</child>
    </joint>

    <!-- ================================================================
         Closest obstacle per side -> ONE ROS message
         (muav_gcs_interfaces/msg/ObstacleInfo on /<ros_namespace>/obstacle_info).
         @NAMESPACE@ is replaced by spawn_px4.launch.py when the model is spawned.
    ================================================================ -->
    <plugin filename="obstacle_info_plugin" name="muav_gcs_gz::ObstacleInfoPlugin">
      <ros_namespace>@NAMESPACE@</ros_namespace>
      <topic>obstacle_info</topic>
      <frame_id>@NAMESPACE@/base_link</frame_id>
      <update_rate>10</update_rate>
    </plugin>

  </model>
</sdf>
